{
  "name": "open-helplines-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source global mental health hotline registry — CC0 data + Apache-2.0 tooling",
  "workspaces": [
    "packages/core",
    "packages/mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "validate": "npm run -w packages/core validate",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages/*/src --ext .ts",
    "build:types": "node scripts/generate-types.mjs",
    "build:types:python": "python3 scripts/generate_python_models.py"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "json-schema-to-typescript": "^14.0.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kouki-odaka/open-helplines.git"
  },
  "license": "Apache-2.0"
}
