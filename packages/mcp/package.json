{
  "name": "@open-helplines/mcp",
  "version": "0.2.0",
  "mcpName": "io.github.Kouki-odaka/open-helplines",
  "description": "MCP server for verified community support resource directory — Safe Answer guardrails enabled (DATA_NOT_FOUND sentinel, staleness checks, fallback chain, mandatory citation)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "helplines",
    "community-support",
    "mental-wellbeing",
    "open-data",
    "cc0",
    "guardrails",
    "safe-answer"
  ],
  "homepage": "https://kouki-odaka.github.io/open-helplines/en/",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "open-helplines-mcp": "dist/src/cli.js"
  },
  "scripts": {
    "prebuild": "node -e \"const{cpSync}=require('fs');cpSync('../../data','./data',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/guardrails.test.js",
    "start": "node dist/src/cli.js"
  },
  "files": [
    "dist/src/**",
    "data/**"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@open-helplines/core": "^0.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kouki-odaka/open-helplines.git",
    "directory": "packages/mcp"
  }
}
